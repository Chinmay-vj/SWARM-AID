{
  "version": "ppo-v1",
  "reward_version": "reward-2",
  "scenarios": ["flood_basic", "wildfire_basic", "earthquake_basic"],
  "agents": 6,
  "horizon": 30,
  "hidden": 128,
  "learning_rate": 0.0003,
  "gamma": 0.99,
  "gae_lambda": 0.95,
  "clip": 0.2,
  "entropy_coefficient": 0.01,
  "value_coefficient": 0.5,
  "max_gradient_norm": 0.5,
  "episodes_per_update": 16,
  "epochs": 4,
  "minibatch": 512,
  "validate_every": 10,
  "validation_episodes": 9,
  "torch_threads": 1
}
