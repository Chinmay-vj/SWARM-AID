# Automated tests build settings in tests/backend_support.py and ignore .env.
# These values document the test profile only.
SWARM_ENVIRONMENT=testing
SWARM_DATABASE_URL=sqlite:///<per-test temporary file>
SWARM_SIMULATION_TICK_DELAY_MS=0
SWARM_SNAPSHOT_EVERY_TICKS=5
