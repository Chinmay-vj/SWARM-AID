# Production-oriented TEMPLATE. Phase 7 is not production-hardened: see
# docs/backend/SECURITY.md before any deployment. Never commit real values.
SWARM_ENVIRONMENT=production
SWARM_DEBUG=false
SWARM_DATABASE_URL=postgresql+psycopg://swarm_aid:<from-secret-store>@<db-host>:5432/swarm_aid
SWARM_JWT_SECRET=<from-secret-store>
SWARM_ACCESS_TOKEN_MINUTES=10
SWARM_REFRESH_TOKEN_MINUTES=480
SWARM_CORS_ORIGINS=["https://<dashboard-host>"]
SWARM_LOG_LEVEL=INFO
SWARM_MAX_REQUEST_BYTES=1000000
SWARM_LOGIN_ATTEMPTS_PER_MINUTE=5
