{
  "$defs": {
    "Dataset": {
      "additionalProperties": false,
      "properties": {
        "dataset_id": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Dataset Id",
          "type": "string"
        },
        "name": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Name",
          "type": "string"
        },
        "origin": {
          "enum": [
            "real",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "maxLength": 100,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        },
        "source_organization": {
          "anyOf": [
            {
              "maxLength": 100,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Organization"
        },
        "official_url": {
          "anyOf": [
            {
              "format": "uri",
              "maxLength": 2083,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Official Url"
        },
        "citation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Citation"
        },
        "licence": {
          "anyOf": [
            {
              "maxLength": 100,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Licence"
        },
        "licence_status": {
          "default": "unverified",
          "enum": [
            "unverified",
            "verified",
            "rejected"
          ],
          "title": "Licence Status",
          "type": "string"
        },
        "privacy_status": {
          "default": "pending",
          "enum": [
            "pending",
            "approved",
            "rejected"
          ],
          "title": "Privacy Status",
          "type": "string"
        },
        "verification": {
          "default": "unverified",
          "enum": [
            "unverified",
            "verified",
            "rejected"
          ],
          "title": "Verification",
          "type": "string"
        },
        "privacy_considerations": {
          "title": "Privacy Considerations",
          "type": "string"
        },
        "modalities": {
          "items": {
            "enum": [
              "image",
              "video",
              "thermal",
              "audio",
              "text",
              "gps",
              "imu",
              "environment",
              "peer"
            ],
            "type": "string"
          },
          "title": "Modalities",
          "type": "array"
        },
        "annotation_types": {
          "items": {
            "maxLength": 100,
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Annotation Types",
          "type": "array"
        },
        "tasks": {
          "items": {
            "maxLength": 100,
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Tasks",
          "type": "array"
        },
        "label_definitions": {
          "patternProperties": {
            "\\S": {
              "type": "string"
            }
          },
          "propertyNames": {
            "maxLength": 100,
            "minLength": 1
          },
          "title": "Label Definitions",
          "type": "object"
        },
        "sample_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sample Count"
        },
        "file_formats": {
          "default": [],
          "items": {
            "maxLength": 100,
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "File Formats",
          "type": "array"
        },
        "estimated_bytes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Estimated Bytes"
        },
        "downloaded_bytes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Downloaded Bytes"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "download_status": {
          "default": "not_downloaded",
          "enum": [
            "not_downloaded",
            "partial",
            "available"
          ],
          "title": "Download Status",
          "type": "string"
        },
        "limitations": {
          "title": "Limitations",
          "type": "string"
        }
      },
      "required": [
        "dataset_id",
        "name",
        "origin",
        "privacy_considerations",
        "modalities",
        "annotation_types",
        "tasks",
        "limitations"
      ],
      "title": "Dataset",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "datasets": {
      "items": {
        "$ref": "#/$defs/Dataset"
      },
      "title": "Datasets",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "datasets"
  ],
  "title": "Registry",
  "type": "object"
}
