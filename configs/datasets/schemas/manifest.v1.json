{
  "$defs": {
    "Annotation": {
      "additionalProperties": false,
      "properties": {
        "format": {
          "enum": [
            "coco",
            "yolo",
            "voc",
            "mask",
            "csv",
            "json",
            "jsonl"
          ],
          "title": "Format",
          "type": "string"
        },
        "asset": {
          "$ref": "#/$defs/Asset"
        },
        "labels": {
          "items": {
            "maxLength": 100,
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "minItems": 1,
          "title": "Labels",
          "type": "array"
        },
        "label_schema_version": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Label Schema Version",
          "type": "string"
        },
        "label_source": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Label Source",
          "type": "string"
        },
        "review_status": {
          "enum": [
            "source",
            "unreviewed",
            "human_reviewed",
            "evaluator_truth"
          ],
          "title": "Review Status",
          "type": "string"
        },
        "review_ref": {
          "anyOf": [
            {
              "maxLength": 100,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Review Ref"
        },
        "boxes": {
          "default": [],
          "items": {
            "maxItems": 4,
            "minItems": 4,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              },
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array"
          },
          "title": "Boxes",
          "type": "array"
        }
      },
      "required": [
        "format",
        "asset",
        "labels",
        "label_schema_version",
        "label_source",
        "review_status"
      ],
      "title": "Annotation",
      "type": "object"
    },
    "Asset": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "availability": {
          "enum": [
            "available",
            "missing",
            "unverified"
          ],
          "title": "Availability",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256",
        "availability"
      ],
      "title": "Asset",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "evidence_id": {
          "format": "uuid",
          "title": "Evidence Id",
          "type": "string"
        },
        "origin": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Origin",
          "type": "string"
        },
        "captured_ms": {
          "minimum": 0,
          "title": "Captured Ms",
          "type": "integer"
        },
        "modality": {
          "enum": [
            "image",
            "video",
            "thermal",
            "text",
            "gps",
            "imu",
            "environment",
            "peer"
          ],
          "title": "Modality",
          "type": "string"
        },
        "artifact_key": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Artifact Key",
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "origin",
        "captured_ms",
        "modality",
        "artifact_key"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "Sample": {
      "additionalProperties": false,
      "properties": {
        "sample_id": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Sample Id",
          "type": "string"
        },
        "source_ref": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Source Ref",
          "type": "string"
        },
        "source_id": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Source Id",
          "type": "string"
        },
        "licence_ref": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Licence Ref",
          "type": "string"
        },
        "modality": {
          "enum": [
            "image",
            "video",
            "thermal",
            "audio",
            "text",
            "gps",
            "imu",
            "environment",
            "peer"
          ],
          "title": "Modality",
          "type": "string"
        },
        "representation": {
          "enum": [
            "physical",
            "symbolic"
          ],
          "title": "Representation",
          "type": "string"
        },
        "split": {
          "enum": [
            "train",
            "validation",
            "test"
          ],
          "title": "Split",
          "type": "string"
        },
        "asset": {
          "anyOf": [
            {
              "$ref": "#/$defs/Asset"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "evidence": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "observation_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observation Id"
        },
        "mission_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mission Id"
        },
        "timestamp": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timestamp"
        },
        "tick_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tick Ms"
        },
        "retrieved_on": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retrieved On"
        },
        "scenario_id": {
          "anyOf": [
            {
              "maxLength": 100,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scenario Id"
        },
        "seed": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seed"
        },
        "sequence_id": {
          "anyOf": [
            {
              "maxLength": 100,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sequence Id"
        },
        "location_group": {
          "anyOf": [
            {
              "maxLength": 100,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Location Group"
        },
        "event_id": {
          "anyOf": [
            {
              "maxLength": 100,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Event Id"
        },
        "incident_id": {
          "anyOf": [
            {
              "maxLength": 100,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Incident Id"
        },
        "pair_id": {
          "anyOf": [
            {
              "maxLength": 100,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pair Id"
        },
        "missing_modalities": {
          "default": [],
          "items": {
            "enum": [
              "image",
              "video",
              "thermal",
              "audio",
              "text",
              "gps",
              "imu",
              "environment",
              "peer"
            ],
            "type": "string"
          },
          "title": "Missing Modalities",
          "type": "array"
        },
        "dimensions": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "exclusiveMinimum": 0,
                  "type": "integer"
                },
                {
                  "exclusiveMinimum": 0,
                  "type": "integer"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dimensions"
        },
        "sample_rate_hz": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sample Rate Hz"
        },
        "annotation": {
          "anyOf": [
            {
              "$ref": "#/$defs/Annotation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "sample_id",
        "source_ref",
        "source_id",
        "licence_ref",
        "modality",
        "representation",
        "split"
      ],
      "title": "Sample",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "manifest_version": {
      "maxLength": 100,
      "minLength": 1,
      "pattern": "\\S",
      "title": "Manifest Version",
      "type": "string"
    },
    "dataset_id": {
      "maxLength": 100,
      "minLength": 1,
      "pattern": "\\S",
      "title": "Dataset Id",
      "type": "string"
    },
    "dataset_version": {
      "maxLength": 100,
      "minLength": 1,
      "pattern": "\\S",
      "title": "Dataset Version",
      "type": "string"
    },
    "origin": {
      "enum": [
        "real",
        "synthetic"
      ],
      "title": "Origin",
      "type": "string"
    },
    "role": {
      "enum": [
        "operational",
        "training_targets",
        "evaluator"
      ],
      "title": "Role",
      "type": "string"
    },
    "samples": {
      "items": {
        "$ref": "#/$defs/Sample"
      },
      "minItems": 1,
      "title": "Samples",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "manifest_version",
    "dataset_id",
    "dataset_version",
    "origin",
    "role",
    "samples"
  ],
  "title": "Manifest",
  "type": "object"
}
