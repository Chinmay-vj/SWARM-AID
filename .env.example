# The simulator, Model 1 and Model 2 (Phases 1-6) use configs/default.toml and need no
# credentials or environment variables. The settings below are for the Phase 7 backend only.
#
# SWARM-AID backend settings. Copy to .env (git-ignored) and replace every placeholder.
# SWARM_JWT_SECRET is mandatory (>= 32 characters). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SWARM_JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
SWARM_ENVIRONMENT=development
SWARM_DATABASE_URL=sqlite:///./runs/backend/swarm_aid.db
# PostgreSQL/PostGIS (see docs/backend/DATABASE.md):
# SWARM_DATABASE_URL=postgresql+psycopg://swarm_aid:CHANGE_ME@127.0.0.1:5432/swarm_aid
SWARM_LOG_LEVEL=INFO
SWARM_CORS_ORIGINS=[]
SWARM_MAX_CONCURRENT_SIMULATIONS=2
SWARM_SIMULATION_TICK_DELAY_MS=100
# Used only by docker-compose.yml for the local database container.
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_ONLY
