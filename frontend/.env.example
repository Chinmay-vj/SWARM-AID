# SWARM-AID dashboard configuration. Vite exposes VITE_* values to the browser bundle:
# never put secrets, passwords or tokens here.
#
# Default data source shown on the sign-in screen: "connected" (Phase 7 backend) or "synthetic".
VITE_API_MODE=connected
# Leave empty to use the same-origin dev/preview proxy (recommended; keeps backend CORS closed).
VITE_API_BASE_URL=
# Request timeout in milliseconds.
VITE_API_TIMEOUT_MS=15000
#
# Server-side only (read by vite.config.ts, not bundled): backend proxy target.
SWARM_BACKEND_URL=http://127.0.0.1:8000
